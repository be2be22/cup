# نام کاربری و رمز ورود به پنل - حتماً تغییر بده
ADMIN_USER=admin
ADMIN_PASS=changeme

# یک رشته تصادفی طولانی برای امنیت سشن - حتماً تغییر بده
SECRET_KEY=change-me-to-a-long-random-string

# مسیر وب‌سوکت (باید با / شروع شود)
WS_PATH=/ws

# پورت داخلی Xray (نیازی به تغییر نیست)
XRAY_PORT=10000

# پورتی که کاربر نهایی از بیرون به آن وصل می‌شود
# روی Bunnyshell معمولاً همان 443 (https) است
PUBLIC_PORT=443
PUBLIC_TLS=true
